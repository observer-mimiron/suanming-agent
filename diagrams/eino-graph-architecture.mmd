graph TD
    subgraph API["5 个核心 API"]
        direction LR
        A1["NewGraph[I,O]"] --> A2["AddLambdaNode"]
        A2 --> A3["AddEdge"]
        A3 --> A4["AddBranch"]
        A4 --> A5["Compile/Invoke"]
    end

    subgraph SINGLE["单领域 bazi 直通链路"]
        direction TB
        START((START)) --> PREFILL["prefill<br/>Go 确定性执行<br/>callTool: bazi_calc/yongshen/dayun"]
        PREFILL --> SPECIALIST["bazi_specialist<br/>LLM Agent 节点<br/>tools: knowledge_catalog/search"]
        SPECIALIST --> BRIDGE["bridge<br/>Go 确定性执行<br/>SSE 事件组装推送"]
        BRIDGE --> ENDNODE((END))
    end

    subgraph MULTI["多领域 fan-out 并行"]
        direction TB
        START2((START)) --> PREFILL2["prefill<br/>Go 确定性执行"]
        PREFILL2 --> BAZI2["bazi_specialist<br/>LLM Agent"]
        PREFILL2 --> ZIWEI2["ziwei_specialist<br/>LLM Agent"]
        BAZI2 --> MERGE["merge<br/>Go 确定性执行<br/>合并两个 specialist 结果"]
        ZIWEI2 --> MERGE
        MERGE --> BRIDGE2["bridge<br/>SSE 输出"]
        BRIDGE2 --> END2((END))
    end

    API -.->|"构建"| SINGLE
    API -.->|"构建"| MULTI

    style PREFILL fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style PREFILL2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style MERGE fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style BRIDGE fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style BRIDGE2 fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px

    style SPECIALIST fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style BAZI2 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style ZIWEI2 fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    style A1 fill:#fff3e0,stroke:#e65100
    style A2 fill:#fff3e0,stroke:#e65100
    style A3 fill:#fff3e0,stroke:#e65100
    style A4 fill:#fff3e0,stroke:#e65100
    style A5 fill:#fff3e0,stroke:#e65100
