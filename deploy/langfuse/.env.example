# Local Langfuse credentials. Copy this file to .env and replace every value.
# The actual .env is ignored by Git and must never contain production credentials.
LANGFUSE_LOCAL_POSTGRES_PASSWORD=replace-with-postgres-password
LANGFUSE_LOCAL_CLICKHOUSE_PASSWORD=replace-with-clickhouse-password
LANGFUSE_LOCAL_REDIS_PASSWORD=replace-with-redis-password
LANGFUSE_LOCAL_MINIO_ACCESS_KEY=replace-with-minio-access-key
LANGFUSE_LOCAL_MINIO_SECRET_KEY=replace-with-minio-secret-key
LANGFUSE_LOCAL_SALT=replace-with-random-salt
LANGFUSE_LOCAL_ENCRYPTION_KEY=replace-with-64-hex-character-key
LANGFUSE_LOCAL_NEXTAUTH_SECRET=replace-with-random-nextauth-secret
LANGFUSE_LOCAL_PROJECT_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_LOCAL_PROJECT_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_LOCAL_ADMIN_PASSWORD=replace-with-local-admin-password
