# 应用主服务（后端 + 内嵌前端构建产物）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-pro
LLM_FLASH_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
DEBUG_TRACE=0
DEBUG_HTTP=0
OTEL_ENABLED=0
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
ROUTER_MODE=off

# 知识库服务（Next.js）
# 这两个 public 变量会在构建阶段注入客户端 bundle。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_OWNER_HANDLE=replace-me

# 知识库运行时密钥
CLERK_SECRET_KEY=sk_test_replace_me
DEEPSEEK_API_KEY=sk_replace_me
KNOWLEDGE_SERVICE_TOKEN=replace-with-a-long-random-string
KNOWLEDGE_SERVICE_PRINCIPAL=knowledge
