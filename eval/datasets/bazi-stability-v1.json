{
  "name": "bazi-stability-v1",
  "description": "八字输出稳定性：同一成人普通看盘输入重复运行，验证合同分级、降级和最终输出稳定",
  "cases": [
    {
      "id": "bazi-stability-1994-nanjing",
      "timeout_seconds": 300,
      "message": "1994年1月21日20点30分 女 南京",
      "response_must_contain_all": ["强弱", "喜神", "用神", "忌神", "大运"],
      "response_must_not_contain": [
        "候选主轴",
        "判断边界：",
        "规则口径：",
        "格局评价：",
        "九维",
        "九级",
        "分析规划器",
        "证据规划器"
      ],
      "expected_route_primary": "bazi",
      "expected_task_intent_any": ["collect_profile", "interpret_chart", "amend_profile"],
      "expected_turn_type_any": ["agent_reading"],
      "required_observations": ["preflight", "sse_emit"],
      "expected_trace_attribute_any": {
        "bazi.final.audit_result": ["clean", "repaired: canonical_parse_failure_facts_only", "repaired: canonical_dynamic_projection_facts_only"],
        "bazi.static.contract_audit": ["clean", "facts_only_degraded"],
        "bazi.static.source": ["model", "facts_only_degraded"],
        "bazi.dynamic.contract_audit": ["clean", "failed:outcome_domain_mismatch", "not_run"],
        "bazi.dynamic.source": ["model", "facts_only_degraded", "unknown"]
      }
    }
  ]
}
