# 命理大师配置文件
# 复制此文件为 .env 并填入实际值

LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-pro
LLM_FLASH_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.3
KNOWLEDGE_MCP_URL=http://localhost:3100
DEBUG_TRACE=0
DEBUG_HTTP=0
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3001/api/public/otel
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>
OTEL_EXPORTER_OTLP_INSECURE=1
OTEL_SERVICE_NAME=suanming-agent
