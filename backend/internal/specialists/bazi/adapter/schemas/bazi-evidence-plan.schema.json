{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "allow_reflection": {"type": "boolean"},
    "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "need_retrieval": {"type": "boolean"},
    "query_packets": {"type": "array", "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "properties": {"preferred_sources": {"type": "array", "items": {"type": "string", "minLength": 1}}, "query": {"type": "string", "minLength": 4, "maxLength": 120}, "source_tier": {"type": "string", "enum": ["A", "B"]}, "topic": {"type": "string", "minLength": 1}}, "required": ["topic", "query", "preferred_sources", "source_tier"]}},
    "recommended_sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "stage": {"type": "string", "enum": ["static", "dynamic"]}
  },
  "required": ["need_retrieval", "stage", "evidence_gaps", "recommended_sources", "query_packets", "allow_reflection"]
}
