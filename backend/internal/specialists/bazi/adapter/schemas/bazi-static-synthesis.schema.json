{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
		"slot": {"type": "string", "enum": ["main_axis", "strength", "tiaohou", "pattern_usage"]},
        "claim_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_topics": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"type": "string", "enum": ["established", "candidate", "limited", "withheld"]},
        "verdict": {"type": "string", "minLength": 4, "maxLength": 80}
      },
		"required": ["slot", "verdict", "status", "fact_refs", "evidence_topics"]
	    }
  },
  "properties": {
    "axis_status": {"type": "string", "enum": ["candidate", "established", "withheld"]},
    "claims": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/definitions/claim"}},
    "pattern_name": {"type": "string", "minLength": 2, "maxLength": 24},
    "pattern_route": {"type": "string", "minLength": 2, "maxLength": 32},
    "pattern_evaluation": {"type": "string", "enum": ["成格", "成格有破", "成格受限", "有成有败", "破格", "暂不定评"]}
  },
  "required": ["claims", "axis_status", "pattern_name", "pattern_route", "pattern_evaluation"]
}
