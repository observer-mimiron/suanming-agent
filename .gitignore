# Local secrets and machine config
.env
.env.*
!.env.example

# Runtime data and logs
/data/
/logs/
*.log
/.pid/
/tmp/
tmp-chat-body.json
*.bak
__pycache__/
*.py[cod]

# Eval generated artifacts and local human-label snapshots
/eval/reports/
/eval/annotation/*.json
/eval/runner/__pycache__/
/eval/datasets/bazi-quality-v1.json

# Build outputs
/dist/
/web/dist/
/server
/backend/server
/web/server
/orchestrator.test
*.test
*.exe

# Root-level accidental Node files; subprojects own their lockfiles.
/node_modules/
/package.json
/package-lock.json

# Local IDE and agent tooling
.idea/
.vscode/
.DS_Store
.codegraph/
.codex-logs/
.claude/
.agents/
.debug/

# Local reference checkouts and generated docs
/docs/agent-interview/
/.codex-go-cache/
