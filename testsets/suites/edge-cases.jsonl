{"id": "edge-01-empty-message", "desc": "空消息 → 400 — handler层拦截空字符串", "difficulty": "easy", "tags": ["error-handling", "empty", "handler"], "setup": {"session_id": "edge-empty", "turns": [{"message": "", "expect": {"http_status": 400}}]}, "signals": {"primary": "handler.HandleChat→BindJSON→strings.TrimSpace→空→c.JSON(400)", "mechanism": "handler层在进入orchestrator之前就拦截"}, "meta": {"source": "handwritten", "verify": "HTTP 400 + 不进入orchestrator.Run"}}
{"id": "edge-02-whitespace-only", "desc": "纯空白 → 400 — handler层拦截纯空格", "difficulty": "easy", "tags": ["error-handling", "whitespace", "handler"], "setup": {"session_id": "edge-ws", "turns": [{"message": "   ", "expect": {"http_status": 400}}]}, "signals": {"primary": "strings.TrimSpace('   ')=''→c.JSON(400)", "mechanism": "同edge-01，TrimSpace后为空"}, "meta": {"source": "handwritten", "verify": "HTTP 400"}}
{"id": "edge-03-gibberish", "desc": "乱码 → graceful降级，不panic不500", "difficulty": "medium", "tags": ["error-handling", "gibberish", "robustness"], "setup": {"session_id": "edge-gib", "turns": [{"message": "asdfghjkl12345!@#$%", "expect": {"turn_type_any": ["ask_missing_profile", "incomplete"], "not_contains": ["panic", "500"]}}]}, "signals": {"primary": "classify→LLM无法识别→fallback extractProfileAndQuestion→无匹配→incomplete→handleAsk", "mechanism": "LLM可能失败→走regex fallback→提取不到出生信息→降级为ask"}, "meta": {"source": "handwritten", "verify": "不panic + 不500 + 返回合理的ask_missing/incomplete"}}
{"id": "edge-04-numbers-only", "desc": "纯数字 → 不误判为出生年份", "difficulty": "medium", "tags": ["error-handling", "numbers", "classification"], "setup": {"session_id": "edge-num", "turns": [{"message": "12345678", "expect": {"turn_type_any": ["ask_missing_profile", "incomplete"]}}]}, "signals": {"primary": "classify→可能提取year=1234(out of range)→或LLM正确识别为无效→fallback→incomplete", "mechanism": "yearRe匹配四位数字→但1900-2100范围检查→1234不在范围内→不提取→最终incomplete"}, "meta": {"source": "handwritten", "verify": "不触发new_profile或full_reading"}}
{"id": "edge-05-bazi-plus-birth-mixed", "desc": "八字+出生时间混合 → 优先new_profile完整排盘", "difficulty": "medium", "tags": ["mixed-input", "priority", "classification"], "setup": {"session_id": "edge-mix", "turns": [{"message": "1990年5月20日早上8点，男，北京。排盘结果是 庚午 辛巳 己卯 戊辰", "expect": {"turn_type": "full_reading"}}]}, "signals": {"primary": "classify prompt规则1→出生时间优先→即使包含八字也走new_profile→full_reading", "mechanism": "'出生时间优先'规则→包含年份+月份+日期→触发new_profile→忽略附带的八字"}, "meta": {"source": "handwritten", "verify": "turn_type=full_reading(不是direct_bazi)"}}
{"id": "edge-06-hello-only", "desc": "纯问候 → 不应panic，正常响应", "difficulty": "easy", "tags": ["greeting", "no-birth-info", "robustness"], "setup": {"session_id": "edge-hello", "turns": [{"message": "你好", "expect": {"turn_type_any": ["ask_missing_profile", "incomplete"]}}]}, "signals": {"primary": "classify→无出生信息→incomplete→handleAsk→返回追问文本", "mechanism": "问候语不包含任何出生信息→分类为incomplete→正常追问→不panic"}, "meta": {"source": "handwritten", "verify": "正常SSE响应+不panic+turn_type合理"}}
