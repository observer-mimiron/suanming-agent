{"name": "flow-basic", "description": "基础会话流程：新建会话→提供八字→追问，验证基本路由和响应"}
{"id": "new-session-birth", "turns": [{"message": "你好，帮我算一下八字，男，1990年5月20日上午10点生的，在北京", "session_id": "flow-basic-01", "expect": {"http_status": 200, "contains_any": ["八字", "排盘", "日主", "天干", "年柱", "月柱", "日柱"]}}]}
{"id": "new-session-female", "turns": [{"message": "我是女生，农历1988年腊月十五下午三点出生，地点上海", "session_id": "flow-basic-02", "expect": {"http_status": 200, "contains_any": ["排盘", "八字", "年柱", "农历", "日主"]}}]}
{"id": "followup-after-birth", "turns": [{"message": "帮我看看八字，男，公历1985年3月15日早上8点，广州", "session_id": "flow-basic-03"}, {"message": "我这八字财运怎么样", "session_id": "flow-basic-03", "expect": {"http_status": 200, "not_contains": ["请提供出生信息", "需要您提供"]}}]}
{"id": "followup-marriage", "turns": [{"message": "算八字，女，1992年7月8日晚上9点，深圳", "session_id": "flow-basic-04"}, {"message": "我什么时候能结婚", "session_id": "flow-basic-04", "expect": {"http_status": 200, "not_contains": ["请提供出生信息", "需要您的出生"]}}]}
{"id": "no-birth-info", "turns": [{"message": "你好，最近压力很大，有什么建议吗？", "session_id": "flow-basic-05", "expect": {"http_status": 200, "not_contains": ["天干地支", "十神", "用神"]}}]}
