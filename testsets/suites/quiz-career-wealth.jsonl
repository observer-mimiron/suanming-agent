{"id": "career-change", "turns": [{"message": "男命，公历1978年2月14日午时，东北沈阳", "session_id": "quiz-career-03"}, {"message": "现在做销售，想转行做餐饮，合适吗？", "session_id": "quiz-career-03", "expect": {"http_status": 200, "not_contains": ["请提供出生信息", "需要您的出生"]}}]}
