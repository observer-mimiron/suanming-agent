{"id": "flow-np-01-complete", "desc": "完整出生信息 → full_reading 排盘", "difficulty": "easy", "tags": ["new_profile", "complete", "smoke"], "setup": {"session_id": "flow-np-comp", "turns": [{"message": "1990年5月20日早上8点，男，北京", "expect": {"turn_type": "full_reading", "not_contains": ["请告诉我你的出生"]}}]}, "signals": {"primary": "classifyAndExtract→new_profile+完整profile→IsProfileComplete=true→handleFullReading→bazi_calc排盘", "mechanism": "LLM提取年份+月份+日期+时辰+性别+地点→profile全部填充→直接full_reading"}, "meta": {"source": "handwritten", "verify": "turn_type=full_reading + SSE包含bazi-chart组件"}}
{"id": "flow-np-02-incomplete", "desc": "不完整信息 → ask_missing_profile", "difficulty": "easy", "tags": ["new_profile", "incomplete", "ask"], "setup": {"session_id": "flow-np-inc", "turns": [{"message": "我想看下八字", "expect": {"turn_type": "ask_missing_profile", "contains_any": ["请提供您的出生"]}}]}, "signals": {"primary": "classify→incomplete→无BaziResult+无Profile→handleAsk→列出缺失字段", "mechanism": "无出生信息→incomplete分支→handleAsk→fieldNames映射→追问所有必填字段"}, "meta": {"source": "handwritten", "verify": "turn_type=ask_missing_profile + 追问文本"}}
{"id": "flow-np-03-incomplete-then-complete", "desc": "先不完整再补全 → ask → full_reading", "difficulty": "medium", "tags": ["new_profile", "multi-turn", "补全"], "setup": {"session_id": "flow-np-ic", "turns": [{"message": "我是1990年生的", "expect": {"turn_type": "ask_missing_profile"}}, {"message": "5月20日早上8点，男，北京", "expect": {"turn_type": "full_reading", "contains_any": ["开始排盘", "信息齐全"]}}]}, "signals": {"primary": "T1→incomplete(仅年份)→handleAsk→T2→new_profile(补全)→IsProfileComplete→full_reading", "mechanism": "T1存储部分Profile→T2 classify识别为补全→MergeProfile合并剩余字段→完整后full_reading"}, "meta": {"source": "handwritten", "verify": "T1=ask + T2=full_reading"}}
{"id": "flow-np-04-update-gender-only", "desc": "纠错性别不改出生时间 → 保留命盘", "difficulty": "medium", "tags": ["new_profile", "update_profile", "gender"], "setup": {"session_id": "flow-np-ug", "turns": [{"message": "1990年5月20日早上8点，男，北京", "expect": {"turn_type": "full_reading"}}, {"message": "不对，我是女的", "expect": {"reuse_chart": true, "contains_any": ["复用已有命盘"], "not_contains": ["请告诉我"]}}]}, "signals": {"primary": "T2→classify update_profile→changed=true→profileChangesAffectChart=false(仅gender变化)→保留BaziResult→followup_reading", "mechanism": "gender不在chartFields→不触发BaziResult=nil→路由到followup而非full_reading"}, "meta": {"source": "handwritten", "verify": "T2复用命盘+不重排"}}
{"id": "flow-np-05-update-year-recalc", "desc": "改年份 → 重新排盘（不保留旧命盘）", "difficulty": "medium", "tags": ["new_profile", "update_profile", "重排"], "setup": {"session_id": "flow-np-uy", "turns": [{"message": "1990年5月20日早上8点，男，北京", "expect": {"turn_type": "full_reading"}}, {"message": "不对，我是1991年的", "expect": {"turn_type": "full_reading", "not_contains": ["复用已有命盘"]}}]}, "signals": {"primary": "T2→update_profile→changed=true→profileChangesAffectChart=true(year在chartFields中且值>0)→BaziResult=nil→full_reading重排", "mechanism": "year在chartFields→值变更→清空BaziResult→触发完整重排→新chart覆盖旧chart"}, "meta": {"source": "handwritten", "verify": "T2=full_reading(重排而非复用)"}}
{"id": "flow-np-06-multi-turn", "desc": "完整排盘后3轮追问不丢上下文", "difficulty": "easy", "tags": ["new_profile", "multi-turn", "followup"], "setup": {"session_id": "flow-np-mt", "turns": [{"message": "1990年5月20日早上8点，男，北京", "expect": {"turn_type": "full_reading"}}, {"message": "今年运势怎么样", "expect": {"reuse_chart": true}}, {"message": "那明年呢", "expect": {"reuse_chart": true}}, {"message": "我适合做什么工作", "expect": {"reuse_chart": true}}]}, "signals": {"primary": "每轮store.LoadOrCreate→BaziResult+Profile完整→classify followup→handleFollowupReading复用", "mechanism": "完整profile+chart→后续全部走followup→reuse_chart贯穿"}, "meta": {"source": "handwritten", "verify": "4轮全reuse_chart"}}
{"id": "flow-np-07-session-isolation", "desc": "两个不同 session_id 互不影响", "difficulty": "medium", "tags": ["new_profile", "isolation", "session"], "setup": {"turns": [{"message": "1990年5月20日早上8点，男，北京", "session_id": "flow-iso-a", "expect": {"turn_type": "full_reading"}}, {"message": "1985年3月15日下午2点，女，上海", "session_id": "flow-iso-b", "expect": {"turn_type": "full_reading"}}, {"message": "婚姻如何？", "session_id": "flow-iso-a", "expect": {"reuse_chart": true}}, {"message": "财运如何？", "session_id": "flow-iso-b", "expect": {"reuse_chart": true}}]}, "signals": {"primary": "不同session_id→不同Store key→各自独立的Profile+BaziResult→互不干扰", "mechanism": "MemoryStore按session_id分组→Locker按session_id串行化→不同session完全隔离"}, "meta": {"source": "handwritten", "verify": "两个session都能正确复用各自命盘，不会串数据"}}
