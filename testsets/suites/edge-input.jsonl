{"id": "edge-unrelated", "turns": [{"message": "推荐一本好看的小说", "session_id": "edge-03", "expect": {"http_status": 200, "turn_type_any": ["ask", "direct_bazi", "bazi_new", "chat"], "not_contains": ["天干", "地支", "十神"]}}]}
